{
  "name": "@zenthcloud/react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skygenesisenterprise/zenthcloud.git"
  },
  "homepage": "https://github.com/skygenesisenterprise/zenthcloud",
  "bugs": {
    "url": "https://github.com/skygenesisenterprise/zenthcloud/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @zenthcloud/react-docs-astro build",
    "codegen": "pnpm --filter @zenthcloud/react-docs-astro codegen:demos && pnpm --filter @zenthcloud/react codegen",
    "build:all": "pnpm -r build",
    "ci:typecheck": "tsc -p ci/tsconfig.json --noEmit",
    "changeset": "tsx ci/scripts/ensure-changeset-config.ts && changeset",
    "clean": "pnpm -r exec rm -rf dist build .astro .wrangler node_modules",
    "dev": "pnpm codegen && pnpm --filter @zenthcloud/react-docs-astro dev",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "lint": "pnpm --filter @zenthcloud/react lint && vp lint packages/*/src",
    "lockfile-check": "pnpm install --no-frozen-lockfile && git diff --exit-code pnpm-lock.yaml",
    "preview": "pnpm --filter @zenthcloud/react-docs-astro preview",
    "publish:beta": "bash ci/versioning/publish-beta.sh",
    "deploy:react-docs-preview": "bash ci/versioning/deploy-react-docs-preview.sh",
    "deploy:react-docs-staging": "bash ci/versioning/deploy-react-docs-staging.sh",
    "ci:post-pr-report": "tsx ci/scripts/post-pr-report.ts",
    "release": "pnpm build:all && changeset publish",
    "release:beta": "changeset publish --no-git-tag --tag beta",
    "release:production": "bash ci/versioning/release-production.sh",
    "react": "node packages/react/dist/command-line/cli.js",
    "test": "pnpm --filter @zenthcloud/react test",
    "test:ci": "tsx --test ci/preview/*.test.ts ci/reporters/*.test.ts ci/scripts/*.test.ts ci/utils/*.test.ts ci/visual-regression/*.test.ts",
    "test:watch": "pnpm --filter @zenthcloud/react test:watch",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version",
    "version:beta": "./ci/versioning/version-beta.sh"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@octokit/rest": "22.0.1",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.12.0"
    }
  },
  "engines": {
    "node": "^24.12.0",
    "pnpm": "^12.3.4"
  }
}
