      "zenthcloudd.exe"
    ]
  },
  "env": {
    "guid": "6bb74449-d10d-4f4a-933e-6fc9fa006eae",
    "vars": [
        {
          "name": "CFDPATH",
          "value": "[INSTALLDIR].",
          "permanent": "no",
          "system": "yes",
          "action": "set",
          "part": "all"
        }
    ]
  },
  "shortcuts": {},
  "choco": {
    "description": "zenthcloudd connects your machine or user identity to Zenthcloud's global network.",
    "project-url": "https://github.com/skygenesisenterprise/zenthcloud",
    "license-url": "https://github.com/skygenesisenterprise/zenthcloud"
  },
  "hooks": [
    {
      "command": "sc.exe create Zenthcloudd binPath=\"[INSTALLDIR]zenthcloudd.exe\" type=share start=auto DisplayName=\"Zenthcloudd\"",
      "when": "install"
    },
    {
      "command": "sc.exe start Zenthcloudd",
      "when": "install"
    },
    {
      "command": "sc.exe delete Zenthcloudd",
      "when": "uninstall"
    }
  ]
