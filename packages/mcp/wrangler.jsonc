{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "zenthcloud-api-mcp-dev",
	"account_id": "6702657b6aa048cf3081ff3ff3c9c52f",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"issues": {
			"enabled": true
		},
		"logs": {
			"enabled": true
		},
		"traces": {
			"enabled": true
		}
	},
	"vars": {
		"ZENTHCLOUD_API_BASE": "https://github.com/skygenesisenterprise/zenthcloud",
		"ZENTHCLOUD_OAUTH_DOMAIN": "https://github.com/skygenesisenterprise/zenthcloud",
		"MCP_RESOURCE": "http://localhost:2529/mcp",
		"RESPONSE_VALIDATION_SAMPLE_RATE": "1"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"services": [
		{
			"binding": "GLOBAL_OUTBOUND",
			"service": "zenthcloud-api-mcp-dev",
			"entrypoint": "GlobalOutbound"
		},
		{
			"binding": "FORGE_TOOLS",
			"service": "zenthcloud-api-mcp-forge-tools-dev"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
		}
	],
	"r2_buckets": [
		{
			"binding": "SPEC_BUCKET",
			"bucket_name": "mcp-spec"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "MCP_METRICS",
			"dataset": "mcp-metrics-dev"
		}
	],
	"triggers": {
		"crons": ["0 */6 * * *"]
	},
	"dev": {
		"port": 2529
	},
	"env": {
		"staging": {
			"name": "zenthcloud-api-mcp-staging",
			"ai": {
				"binding": "AI"
			},
			"routes": [
				{
					"pattern": "staging.mcp.zenthcloud.com",
					"custom_domain": true
				}
			],
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			],
			"services": [
				{
					"binding": "GLOBAL_OUTBOUND",
					"service": "zenthcloud-api-mcp-staging",
					"entrypoint": "GlobalOutbound"
				},
				{
					"binding": "FORGE_TOOLS",
					"service": "zenthcloud-api-mcp-forge-tools-staging"
				}
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id":"cd658e2801ac4ae6b18082e375f176a3"
				}
			],
			"r2_buckets": [
				{
					"binding": "SPEC_BUCKET",
					"bucket_name": "mcp-spec-staging"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-staging"
				}
			],
			"triggers": {
				"crons": ["0 */6 * * *"]
			},
			"vars": {
				"ZENTHCLOUD_API_BASE": "https://github.com/skygenesisenterprise/zenthcloud",
				"ZENTHCLOUD_OAUTH_DOMAIN": "https://github.com/skygenesisenterprise/zenthcloud",
				"MCP_RESOURCE": "https://github.com/skygenesisenterprise/zenthcloud",
				"RESPONSE_VALIDATION_SAMPLE_RATE": "1"
			}
		},
		"production": {
			"name": "zenthcloud-api-mcp",
			"ai": {
				"binding": "AI"
			},
			"routes": [
				{
					"pattern": "mcp.zenthcloud.com",
					"custom_domain": true
				}
			],
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			],
			"services": [
				{
					"binding": "GLOBAL_OUTBOUND",
					"service": "zenthcloud-api-mcp",
					"entrypoint": "GlobalOutbound"
				},
				{
					"binding": "FORGE_TOOLS",
					"service": "zenthcloud-api-mcp-forge-tools"
				}
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "c7d4e4f11dfe41e6a22228aa838a14f1"
				}
			],
			"r2_buckets": [
				{
					"binding": "SPEC_BUCKET",
					"bucket_name": "mcp-spec-production"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-production"
				}
			],
			"triggers": {
				"crons": ["0 */6 * * *"]
			},
			"vars": {
				"ZENTHCLOUD_API_BASE": "https://github.com/skygenesisenterprise/zenthcloud",
				"ZENTHCLOUD_OAUTH_DOMAIN": "https://github.com/skygenesisenterprise/zenthcloud",
				"MCP_RESOURCE": "https://github.com/skygenesisenterprise/zenthcloud",
				"RESPONSE_VALIDATION_SAMPLE_RATE": "1"
			}
		}
	}
}
