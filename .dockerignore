# Dependency and build artifacts
node_modules
**/node_modules
**/.next
# Build artifacts are not needed by the runtime image. The design-system dist is
# the exception: `packages/node` sits outside the pnpm workspace, so
# `@zenthcloud/react` is consumed as a prebuilt package and must ship with the
# image (the app imports both its JS and its styles.css).
apps/zenthcloud/dist
packages/server/dist
packages/speedtest/dist
packages/vinext/packages/types/next/upstream/dist
**/*.tsbuildinfo
.turbo
coverage

# Status engine runtime state (SQLite database, snapshot, backups). The
# container keeps it in a volume, never in the build context.
apps/status/data
apps/status/.status-data
packages/status/data
.make-product

# Desktop (Electron) and website packaging artifacts: several GB of local build
# output that the server image never needs. Without these the build context is
# ~2.4GB instead of a few MB. The desktop client now lives inside the Zenthcloud
# app package, under `apps/zenthcloud/electron/`.
apps/zenthcloud/electron/release
apps/zenthcloud/electron/out
web/apps/docs/out
web/apps/website/.next

# Version control and CI
.git
.gitignore
.github

# Local environment files (keep the committed *.example files)
.env
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Editor / OS noise
.DS_Store
.vscode
.idea
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docs and non-runtime assets are not needed to build the image.
README.md
